PORT=5000
SUPABASE_URL=https://rfzrxowsabojzcirasiv.supabase.co

# DÙNG service_role KEY (Settings -> API -> service_role), KHÔNG dùng anon key.
# Hai bảng đã bật RLS nên anon key sẽ bị chặn hoàn toàn.
# Key này chỉ được để ở backend, không bao giờ đưa ra frontend.
SUPABASE_KEY=your_service_role_key

# Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key

# Origin của frontend được phép gọi API (nhiều origin cách nhau bằng dấu phẩy).
# Mỗi mục có thể chứa dấu * để khớp nhiều tên miền, ví dụ https://*.vercel.app
CORS_ORIGIN=http://localhost:5173
